# /opt/remote-hub/hub.env  (0640 root:remotehub)
HUB_BASE_HOST=remote.zhuhedong.cn
HUB_ZONE=d.remote.zhuhedong.cn
# Where Caddy reaches the hub. 127.0.0.1 when Caddy runs on the host;
# the docker bridge gateway (e.g. 172.17.0.1) when Caddy runs in a container
# without host networking. deploy.sh sets these automatically.
HUB_LISTEN=127.0.0.1:9440
HUB_ASK_LISTEN=127.0.0.1:9441
HUB_TRUST_PROXY=1
HUB_TRUSTED_PROXIES=127.0.0.1/32,::1/128
